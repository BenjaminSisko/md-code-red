  "read_only_cases": [
    {
      "id": "identity",
      "command": "cat /etc/redhat-release",
      "proves": "claimed RHEL release"
    },
    {
      "id": "kernel",
      "command": "uname -r",
      "proves": "observed kernel identity"
    },
    {
      "id": "service",
      "command": "systemctl status sshd.service",
      "proves": "service-query shape"
    },
    {
      "id": "journal",
      "command": "journalctl -u sshd.service -n 20 --no-pager",
      "proves": "bounded journal-query shape"
    },
    {
      "id": "firewalld",
      "command": "firewall-cmd --state",
      "proves": "firewalld status-query shape"
    },
    {
      "id": "network",
      "command": "nmcli device status",
      "proves": "NetworkManager query shape"
    },
    {
      "id": "packages",
      "command": "dnf repolist",
      "proves": "repository-query shape"
    },
    {
      "id": "lvm",
      "command": "lvs --noheadings",
      "proves": "LVM query shape"
    },
    {
      "id": "selinux",
      "command": "getenforce",
      "proves": "SELinux-mode query shape"
    },
    {
      "id": "time",
      "command": "chronyc tracking",
      "proves": "time-status query shape"
    },
    {
      "id": "logging",
      "command": "rsyslogd -N1",
      "proves": "configuration parse only; not end-to-end receipt"
    }
  ]
